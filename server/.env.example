# Frontend URL (CORS & Socket.IO)
CLIENT_URL="http://localhost:5173"

# Midtrans Sandbox (Dev 2)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
