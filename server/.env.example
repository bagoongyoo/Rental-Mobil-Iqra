# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# MySQL 8 (atau MariaDB). Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DB
DATABASE_URL="mysql://root:password@localhost:3306/rental_iqra"

# Ganti dengan string acak panjang (mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d

# Pembayaran: "simulate" (tombol bayar palsu untuk development) atau "midtrans"
PAYMENT_MODE=simulate
PAYMENT_TIMEOUT_MINUTES=60
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Akun admin pertama (dipakai oleh seed)
SEED_ADMIN_EMAIL=admin@iqra.test
SEED_ADMIN_PASSWORD=admin123

# Kode verifikasi (OTP) untuk ganti / lupa kata sandi.
# simulate = tidak mengirim apa-apa, kode dicetak di log server (dan tampil di layar saat development).
OTP_EMAIL_MODE=simulate
# Isi jika OTP_EMAIL_MODE=smtp. Gmail: aktifkan verifikasi 2 langkah lalu buat "App Password" (16 huruf), bukan sandi biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rental Mobil Iqra <emailkamu@gmail.com>"
# simulate | fonnte (gateway WhatsApp, daftar di fonnte.com lalu salin token perangkat)
OTP_WHATSAPP_MODE=simulate
FONNTE_TOKEN=
